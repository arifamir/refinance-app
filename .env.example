# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL="postgresql://refinance:refinance@localhost:5432/refinance?schema=public"
REDIS_URL="redis://localhost:6379"

# --- API ---
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Staff guard for /ops/*. Unset = open (demo mode). Set a strong secret in any
# shared/production environment; requests then need an `x-ops-token` header.
OPS_TOKEN=""

# --- PII ---
# Personal numbers are hashed (lookup) and encrypted (authorised read).
# Dev defaults are used if unset; both MUST be set in production.
# Generate a key with: openssl rand -hex 32
PII_KEY=""
PN_PEPPER="dev-pepper-not-for-production"

# --- Adapters -------------------------------------------------------------
# Everything external is behind a port (see packages/adapters).
# Fakes are the default so the whole flow runs with no vendor contracts.

# BankID. Real mode needs a pfx + the BankID test app; see PLAN.md section 9.
USE_REAL_BANKID=false
BANKID_PFX=""
BANKID_PASSPHRASE=""

# How many collect() polls before a fake BankID order completes.
# Simulates the user picking up their phone.
FAKE_BANKID_COLLECTS_UNTIL_COMPLETE=2

# Fake payment provider: fail this many attempts per idempotency key before
# succeeding. Set to 2 to watch BullMQ retry a disbursement without double-paying.
FAKE_PAYMENT_TRANSIENT_FAILURES=1

# Artificial latency (ms) on fake external calls, to make async behaviour visible.
FAKE_LATENCY_MS=800

# --- Schedulers -----------------------------------------------------------
# Real system: collection is monthly, accrual daily. Compressed here so a demo
# actually shows something. Values are cron patterns.
COLLECTION_CRON="*/30 * * * * *"
ACCRUAL_CRON="*/60 * * * * *"
